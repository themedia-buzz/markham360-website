---
import { getCollection } from 'astro:content';
import AuthorDetail from '../../views/AuthorDetail.astro';

export async function getStaticPaths() {
  const authors = await getCollection('authors', (a) => !a.data.draft);
  return authors.map((author) => ({
    params: { slug: author.id },
    props: { author },
  }));
}

const { author } = Astro.props;
---
<AuthorDetail locale="en" author={author} />
