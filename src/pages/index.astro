---
import BaseLayout from '../layouts/BaseLayout.astro';
import CampaignBanner from '../components/CampaignBanner.astro';
import Masthead from '../components/Masthead.astro';
import Nav from '../components/Nav.astro';
import StoryCard from '../components/StoryCard.astro';
import PausedBanner from '../components/PausedBanner.astro';
import PillarCard from '../components/PillarCard.astro';
import Footer from '../components/Footer.astro';
import { UI, PILLARS, CONTINUITY } from '../utils/constants';
import { buildFeed } from '../utils/feed';

const locale = 'en' as const;
const t = UI[locale];
const base = import.meta.env.BASE_URL;

const feed = await buildFeed(base, locale);
const editions = feed.filter((i) => i.kind === 'edition');
const events = feed.filter((i) => i.kind === 'event');
const videos = feed.filter((i) => i.kind === 'video');

const lead = editions[0] ?? feed[0];
const rail = feed
  .filter((i) => i.id !== lead?.id)
  .filter((i) => i.image || i.youtubeId || i.kind === 'edition')
  .slice(0, 4);
const moreEditions = editions.slice(0, 6);
const community = events.slice(0, 6);
const explainers = videos.slice(0, 6);

const meanings: Record<string, string> = {
  'safe-community': 'Safer streets and watchful neighbourhoods.',
  'moving-people-forward': 'Roads that move and transit that reaches you.',
  'accountable-leadership': 'Weekly updates, without fail.',
  'resilient-infrastructure': 'Neighbourhoods built to last.',
  'tax-dollars-that-work': 'Careful with money, clear about results.',
};
---
<BaseLayout title="Markham 360 — Regional Councillor Alan Ho" locale={locale}>
  <CampaignBanner recordHref="/record" />

  <header class="paper-header">
    <div class="container">
      <Masthead locale={locale} centered />
    </div>
  </header>

  <Nav locale={locale} />

  <main>
    <section class="container lead-band">
      <div class="lead-grid">
        <div class="lead-main">
          {lead && (
            <StoryCard
              size="lead"
              kind={lead.kind}
              href={lead.href}
              label={lead.label}
              title={lead.title}
              dek={lead.dek}
              dateLabel={lead.dateLabel}
              image={lead.image}
              youtubeId={lead.youtubeId}
              folio={lead.episode ? String(lead.episode) : undefined}
            />
          )}
        </div>
        <aside class="lead-rail" aria-label="More stories">
          <p class="label rail-head">Also filing</p>
          {rail.map((item) => (
            <StoryCard
              size="rail"
              kind={item.kind}
              href={item.href}
              label={item.label}
              title={item.title}
              dek={item.dek}
              dateLabel={item.dateLabel}
              image={item.image}
              youtubeId={item.youtubeId}
              folio={item.episode ? String(item.episode) : undefined}
            />
          ))}
        </aside>
      </div>
    </section>

    <div class="container">
      <PausedBanner locale={locale} />
    </div>

    <section class="band">
      <div class="container">
        <div class="band-head">
          <h2>Latest editions</h2>
          <a class="band-link" href={`${base}/markham-360`}>{t.archive} →</a>
        </div>
        <p class="band-lede measure">
          {CONTINUITY.editions} consecutive weekly Markham 360 editions since {CONTINUITY.since}.
          The 2026 run is indexed here as the newspaper of record.
        </p>
        <div class="edition-strip">
          {moreEditions.map((item) => (
            <StoryCard
              kind="edition"
              href={item.href}
              label={item.label}
              title={item.title}
              dek={item.dek}
              dateLabel={item.dateLabel}
              image={item.image}
              folio={item.episode ? String(item.episode) : undefined}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="band surface-white">
      <div class="container">
        <div class="band-head">
          <h2>{t.community}</h2>
          <a class="band-link" href={`${base}/community`}>All events →</a>
        </div>
        <div class="photo-row">
          {community.map((item) => (
            <StoryCard
              kind="event"
              href={item.href}
              label={item.label}
              title={item.title}
              dek={item.dek}
              dateLabel={item.dateLabel}
              image={item.image}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="container">
        <div class="band-head">
          <h2>Explainers</h2>
          <a class="band-link" href={`${base}/video`}>All explainers →</a>
        </div>
        <p class="band-lede measure">
          Articles where the video is the main content: short municipal explainers for residents.
        </p>
        <div class="photo-row">
          {explainers.map((item) => (
            <StoryCard
              kind="video"
              href={item.href}
              label={item.label}
              title={item.title}
              dek={item.dek}
              dateLabel={item.dateLabel}
              image={item.image}
              youtubeId={item.youtubeId}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="band surface-white">
      <div class="container">
        <div class="band-head">
          <h2>S.M.A.R.T. platform</h2>
          <a class="band-link" href={`${base}/record`}>{t.record} →</a>
        </div>
        <p class="band-lede measure">Five commitments, each backed by a public record.</p>
        <div class="pillar-list">
          {PILLARS.map((p) => (
            <PillarCard
              letter={p.letter}
              title={p.title}
              meaning={meanings[p.slug]}
              href={`${base}/record/${p.slug}`}
            />
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</BaseLayout>

<style>
  .paper-header {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.7) 0%, transparent 70%),
      var(--colour-paper);
  }

  .lead-band { padding-block: var(--space-7) var(--space-5); }
  .lead-grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 960px) {
    .lead-grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(17rem, 0.85fr);
      gap: var(--space-7);
    }
  }
  .lead-main { min-width: 0; }
  .lead-rail {
    border-top: 1px solid var(--colour-rule);
    padding-top: var(--space-3);
  }
  @media (min-width: 960px) {
    .lead-rail {
      border-top: 0;
      border-left: 1px solid var(--colour-rule);
      padding-top: 0;
      padding-left: var(--space-5);
    }
  }
  .rail-head { margin: 0 0 var(--space-1); }

  .band {
    padding-block: var(--section-gap);
    border-top: 1px solid var(--colour-rule);
  }
  .surface-white { background: var(--colour-white); }
  .band-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .band-head h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
  }
  .band-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .band-lede {
    margin: 0 0 var(--space-6);
    color: var(--colour-muted);
  }

  .edition-strip,
  .photo-row {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 640px) {
    .edition-strip,
    .photo-row { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .edition-strip { grid-template-columns: repeat(3, 1fr); }
    .photo-row { grid-template-columns: repeat(3, 1fr); }
  }

  .pillar-list {
    display: grid;
    gap: 0;
    max-width: 52rem;
    border-top: 1px solid var(--colour-rule);
  }
</style>
