---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Nav from '../../components/Nav.astro';
import EventCard from '../../components/EventCard.astro';
import Footer from '../../components/Footer.astro';
import { UI } from '../../utils/constants';

const locale = 'en' as const;
const t = UI[locale];
const base = import.meta.env.BASE_URL;
const all = await getCollection('events', (e) => e.data.locale === 'en' && !e.data.draft);
---
<BaseLayout title="In the Community — Alan Ho" locale={locale}>
  <header class="container" style="padding-block: var(--space-6);"><Masthead locale={locale} /></header>
  <Nav locale={locale} />
  <main class="container" style="padding-block: var(--section-gap);">
    <h1>{t.community}</h1>
    <p class="measure">Food drives, charity concerts, community picnics, safety forums, and more.</p>
    <div class="grid">
      {all
        .slice()
        .sort((a, b) => b.data.date.localeCompare(a.data.date))
        .map((e) => (
        <EventCard
          href={`${base}/community/${e.slug.replace(/^en\//, '')}`}
          title={e.data.title}
          date={e.data.date}
          summary={e.data.summary}
          image={e.data.gallery?.[0]}
        />
      ))}
      {all.length === 0 && <p class="label">Community events will appear here once seeded.</p>}
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>
<style>
  .grid { display: grid; gap: var(--space-5); margin-top: var(--space-6); }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
