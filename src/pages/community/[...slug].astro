---
import { getCollection, type CollectionEntry } from 'astro:content';
import CommunityDetail from '../../views/CommunityDetail.astro';
import { contentSlug, includeDraftContent } from '../../utils/i18n';

export async function getStaticPaths() {
  const locale = 'en' as const;
  const allowDraft = includeDraftContent(locale);
  const events = await getCollection(
    'events',
    (e) => e.data.locale === locale && (allowDraft || !e.data.draft)
  );
  return events.map((entry) => ({
    params: { slug: contentSlug(entry.slug) },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'events'>; }
const { entry } = Astro.props;
---
<CommunityDetail locale="en" entry={entry} />
