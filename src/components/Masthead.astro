---
import { CONTINUITY } from '../utils/constants';
import { href, type Locale } from '../utils/i18n';
interface Props { locale?: Locale; centered?: boolean; }
const { locale = 'en', centered = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = href(base, locale, '/');
const standing: Record<Locale, string> = {
  en: 'A local community newspaper for Markham, with contributors who serve the region.',
  fr: 'Un journal communautaire local pour Markham, avec des contributeurs au service de la région.',
  'zh-HK': '報道萬錦事務的本地社區報紙，匯集服務本區的作者與社區。',
  'zh-CN': '报道万锦事务的本地社区报纸，汇集服务本区的作者与社区。',
};
const folio: Record<Locale, string> = {
  en: `${CONTINUITY.editions} consecutive weekly editions since ${CONTINUITY.since}`,
  fr: `${CONTINUITY.editions} éditions hebdomadaires consécutives depuis ${CONTINUITY.since}`,
  'zh-HK': `自 ${CONTINUITY.since} 年起連續 ${CONTINUITY.editions} 期`,
  'zh-CN': `自 ${CONTINUITY.since} 年起连续 ${CONTINUITY.editions} 期`,
};
---
<a href={home} class:list={['masthead', { centered }]} aria-label="Markham 360 home">
  <span class="wordmark">Markham <span class="accent">360</span></span>
  <span class="standing label">{standing[locale]}</span>
  {centered && (
    <span class="folio label">{folio[locale]}</span>
  )}
</a>
<style>
  .masthead {
    display: inline-flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--colour-ink);
  }
  .masthead.centered {
    display: flex;
    align-items: center;
    text-align: center;
    width: 100%;
    padding-block: var(--space-6) var(--space-4);
  }
  .masthead:hover { text-decoration: none; }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .standing { color: var(--colour-muted); }
  .folio { margin-top: var(--space-2); color: var(--colour-muted); }
</style>
