---
import { LOCALES, LOCALE_LABELS, localizePath, pathWithoutLocale, withBase, type Locale } from '../utils/i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = pathWithoutLocale(Astro.url.pathname, base);
const hrefFor = (l: Locale) => withBase(base, localizePath(path, l));
const languageLabel: Record<Locale, string> = {
  en: 'Language',
  fr: 'Langue',
  'zh-HK': '語言',
  'zh-CN': '语言',
};
---
<div class="lang" role="navigation" aria-label={languageLabel[locale]}>
  {LOCALES.map((l) => (
    <a href={hrefFor(l)} aria-current={l === locale ? 'true' : undefined} class={l === locale ? 'current' : ''}>{LOCALE_LABELS[l]}</a>
  ))}
</div>
<style>
  .lang { display: inline-flex; gap: var(--space-3); font-family: var(--font-mono); font-size: 0.8rem; }
  .lang a { color: var(--colour-muted); }
  .lang a.current { color: var(--colour-accent); }
</style>
