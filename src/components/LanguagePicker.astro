---
import { LOCALES, LOCALE_LABELS, type Locale } from '../utils/i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
// Simple locale switch to each locale's home. Per-page equivalents can be
// wired later once routes stabilise.
const hrefFor = (l: Locale) => (l === 'en' ? `${base}/` : `${base}/${l}/`);
---
<div class="lang" role="navigation" aria-label="Language">
  {LOCALES.map((l) => (
    <a href={hrefFor(l)} aria-current={l === locale ? 'true' : undefined} class={l === locale ? 'current' : ''}>{LOCALE_LABELS[l]}</a>
  ))}
</div>
<style>
  .lang { display: inline-flex; gap: var(--space-3); font-family: var(--font-mono); font-size: 0.8rem; }
  .lang a { color: var(--colour-muted); }
  .lang a.current { color: var(--colour-accent); }
</style>
