---
interface Props {
  href: string;
  title: string;
  dayLabel: string;
  meta: string;
  free?: boolean;
  freeLabel?: string;
  registerHref?: string;
  registerLabel?: string;
  /** denser layout for the homepage rail */
  compact?: boolean;
}
const {
  href,
  title,
  dayLabel,
  meta,
  free = false,
  freeLabel = 'Free',
  registerHref,
  registerLabel = 'Register',
  compact = false,
} = Astro.props;
---
<article class:list={['upcoming-row', { compact }]}>
  <time class="day label">{dayLabel}</time>
  <div class="body">
    <h3><a href={href}>{title}</a></h3>
    <p class="meta">
      {meta}
      {free && <span class="pill">{freeLabel}</span>}
    </p>
  </div>
  {registerHref && (
    <a class="register" href={registerHref} rel="noopener noreferrer">{registerLabel}</a>
  )}
</article>
<style>
  .upcoming-row {
    display: grid;
    grid-template-columns: 4.25rem 1fr auto;
    gap: var(--space-3) var(--space-4);
    align-items: start;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--colour-rule);
  }
  .upcoming-row.compact {
    grid-template-columns: 3.5rem 1fr;
    padding-block: var(--space-3);
  }
  .upcoming-row.compact .register {
    grid-column: 2;
    justify-self: start;
    margin-top: calc(var(--space-1) * -1);
  }
  .day {
    margin: 0;
    color: var(--colour-accent);
    line-height: 1.3;
  }
  .body { min-width: 0; }
  h3 {
    margin: 0 0 var(--space-1);
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.25;
  }
  .compact h3 { font-size: 0.98rem; }
  h3 a { color: var(--colour-ink); }
  h3 a:hover { color: var(--colour-accent); text-decoration: none; }
  .meta {
    margin: 0;
    color: var(--colour-muted);
    font-size: 0.85rem;
  }
  .pill {
    display: inline-block;
    margin-left: var(--space-2);
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--colour-rule);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--colour-muted);
  }
  .register {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--colour-ink);
    border-radius: var(--radius-sm);
    color: var(--colour-ink);
    text-decoration: none;
  }
  .register:hover {
    border-color: var(--colour-accent);
    color: var(--colour-accent);
    text-decoration: none;
  }
</style>
