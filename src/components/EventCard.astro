---
interface Props {
  href: string;
  title: string;
  date: string;
  summary: string;
  image?: { src: string; alt: string };
}
const { href, title, date, summary, image } = Astro.props;
---
<article class="event-card">
  <a href={href} class:list={['cover', { photo: Boolean(image), folio: !image }]} aria-label={title}>
    {image ? (
      <img src={image.src} alt={image.alt} loading="lazy" />
    ) : (
      <>
        <span class="folio-num accent">In</span>
        <span class="folio-cap label">Community</span>
      </>
    )}
  </a>
  <p class="meta label">{date}</p>
  <h3><a href={href}>{title}</a></h3>
  <p class="summary">{summary}</p>
</article>
<style>
  .event-card {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--colour-rule);
    grid-template-rows: auto auto auto 1fr;
  }
  .cover {
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--colour-rule);
    text-decoration: none;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover.folio {
    display: grid;
    align-content: end;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--colour-rule);
    background:
      linear-gradient(160deg, #fff 0%, #f7f3ec 45%, #e8efe8 100%);
  }
  .folio-num {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
  }
  .folio-cap { margin: 0; }
  .event-card .meta { margin: 0; }
  .event-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.25;
  }
  .event-card h3 a { color: var(--colour-ink); }
  .event-card h3 a:hover { color: var(--colour-accent); text-decoration: none; }
  .summary { margin: 0; color: var(--colour-muted); }
</style>
