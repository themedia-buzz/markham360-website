---
import { COUNCILLOR, PAGE_COPY, councillorRole, councillorOffice } from '../utils/constants';
import { type Locale } from '../utils/i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const year = new Date().getFullYear();
const copy = PAGE_COPY[locale];
const emailLabel = locale === 'fr' ? 'Courriel' : 'Email';
---
<footer class="footer">
  <div class="container">
    <p class="name">
      {locale === 'zh-HK' || locale === 'zh-CN'
        ? `${councillorRole(locale)}${COUNCILLOR.nameZh} · ${COUNCILLOR.nameEn}`
        : `${councillorRole(locale)} ${COUNCILLOR.nameEn} · ${COUNCILLOR.nameZh}`}
    </p>
    <p class="muted">{councillorRole(locale)}</p>
    <p class="muted">{councillorOffice(locale)}</p>
    <p class="muted">{emailLabel}: <a href={`mailto:${COUNCILLOR.email}`}>{COUNCILLOR.email}</a></p>
    <hr class="rule" />
    <p class="label">© {year} {copy.footerCopyright}</p>
  </div>
</footer>
<style>
  .footer { border-top: 1px solid var(--colour-rule); margin-top: var(--section-gap); padding-block: var(--space-8); background: var(--colour-white); }
  .name { font-family: var(--font-display); font-size: 1.25rem; margin: 0 0 var(--space-2); }
  .muted { color: var(--colour-muted); margin: 0 0 var(--space-2); }
  .footer .rule { margin-block: var(--space-6); }
</style>
