---
interface Props {
  href: string;
  label: string;
  title: string;
  dek: string;
  dateLabel?: string;
  image?: { src: string; alt: string };
  youtubeId?: string;
  size?: 'lead' | 'rail' | 'grid';
  folio?: string;
  /** Drives the default thumbnail when no image is present. */
  kind?: 'edition' | 'event' | 'video';
}
const {
  href,
  label,
  title,
  dek,
  dateLabel,
  image,
  youtubeId,
  size = 'grid',
  folio,
  kind = 'edition',
} = Astro.props;

const hasPhoto = Boolean(image);
const defaults: Record<string, { mark: string; cap: string }> = {
  edition: { mark: folio ?? '360', cap: 'Markham 360' },
  event: { mark: 'In', cap: 'Community' },
  video: { mark: '▶', cap: 'Explainer' },
};
const fallback = defaults[kind] ?? defaults.edition;
---
<article class:list={['story', size, `kind-${kind}`]}>
  <a href={href} class:list={['media', { photo: hasPhoto, folio: !hasPhoto }]} aria-label={title}>
    {hasPhoto ? (
      <img src={image!.src} alt={image!.alt} loading="lazy" />
    ) : (
      <>
        <span class="folio-num accent">{fallback.mark}</span>
        <span class="folio-cap label">{fallback.cap}</span>
      </>
    )}
    {(youtubeId || kind === 'video') && <span class="play" aria-hidden="true">▶</span>}
  </a>
  <div class="body">
    <p class="meta label">
      <span class="accent">{label}</span>
      {dateLabel && <> · {dateLabel}</>}
    </p>
    <h3><a href={href}>{title}</a></h3>
    <p class="dek">{dek}</p>
  </div>
</article>
<style>
  .story {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    grid-template-rows: auto 1fr;
  }
  .story.lead { gap: var(--space-4); }

  /* Media slot is always present so grid baselines stay aligned. */
  .media {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--colour-rule);
    aspect-ratio: 3 / 2;
    text-decoration: none;
  }
  .story.lead .media { aspect-ratio: 16 / 10; }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media.folio {
    display: grid;
    align-content: end;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--colour-rule);
    background:
      linear-gradient(145deg, var(--colour-white) 0%, var(--colour-paper) 50%, #efe9e0 100%);
  }
  .kind-event .media.folio {
    background:
      linear-gradient(160deg, #fff 0%, #f7f3ec 45%, #e8efe8 100%);
  }
  .kind-video .media.folio {
    background:
      linear-gradient(160deg, #1a1a1a 0%, #2c2c2c 55%, #3a3a3a 100%);
  }
  .kind-video .media.folio .folio-cap { color: rgba(255, 255, 255, 0.65); }
  .kind-video .media.folio .folio-num { color: #fff; }

  .folio-num {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .kind-video .folio-num { font-size: clamp(2rem, 4vw, 2.75rem); }
  .folio-cap { margin: 0; }

  .play {
    position: absolute;
    inset: auto auto var(--space-3) var(--space-3);
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    background: var(--colour-accent);
    color: #fff;
    font-size: 0.75rem;
    border-radius: var(--radius-sm);
  }

  .meta { margin: 0; }
  .story h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.2;
  }
  .story.lead h3 { font-size: clamp(1.45rem, 2.6vw, 2rem); }
  .story.rail h3 { font-size: 1.05rem; }
  .story h3 a { color: var(--colour-ink); }
  .story h3 a:hover { color: var(--colour-accent); text-decoration: none; }
  .dek {
    margin: 0;
    color: var(--colour-muted);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .story.lead .dek {
    -webkit-line-clamp: 3;
    font-size: 1.02rem;
  }

  .story.rail {
    grid-template-columns: 88px 1fr;
    grid-template-rows: auto;
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--colour-rule);
  }
  .story.rail .media { aspect-ratio: 1; }
  .story.rail .media.folio {
    padding: var(--space-2);
    justify-items: center;
    align-content: center;
    text-align: center;
  }
  .story.rail .folio-num { font-size: 1.25rem; }
  .story.rail .folio-cap { display: none; }
  .story.rail .dek { -webkit-line-clamp: 2; font-size: 0.85rem; }
  .story.rail .play { width: 1.5rem; height: 1.5rem; font-size: 0.6rem; }
</style>
