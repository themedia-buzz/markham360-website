---
import type { CollectionEntry } from 'astro:content';
import { UI } from '../utils/constants';
import { authorDisplayName } from '../utils/authors';
import { href, type Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
  author: CollectionEntry<'authors'>;
}
const { locale, author } = Astro.props;
const t = UI[locale];
const base = import.meta.env.BASE_URL;
const name = authorDisplayName(author, locale);
const profileHref = href(base, locale, `/authors/${author.id}`);
---
<p class="byline label">
  {t.byline}
  {' '}
  <a href={profileHref}>{name}</a>
</p>
<style>
  .byline {
    margin: 0 0 var(--space-4);
    color: var(--colour-muted);
  }
  .byline a {
    color: var(--colour-ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .byline a:hover { color: var(--colour-accent); }
</style>
