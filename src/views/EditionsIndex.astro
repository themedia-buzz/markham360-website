---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Nav from '../components/Nav.astro';
import StoryCard from '../components/StoryCard.astro';
import PausedBanner from '../components/PausedBanner.astro';
import Footer from '../components/Footer.astro';
import { UI, PAGE_COPY } from '../utils/constants';
import {
  contentSlug,
  formatDate,
  href,
  includeDraftContent,
  type Locale,
} from '../utils/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = UI[locale];
const copy = PAGE_COPY[locale];
const base = import.meta.env.BASE_URL;
const allowDraft = includeDraftContent(locale);

const [editions, videos] = await Promise.all([
  getCollection(
    'editions',
    (e) => e.data.locale === locale && (allowDraft || !e.data.draft)
  ),
  getCollection(
    'video',
    (e) => e.data.locale === locale && (allowDraft || !e.data.draft)
  ),
]);

const series = [
  ...editions.map((e) => ({
    kind: 'edition' as const,
    id: e.id,
    href: href(base, locale, `/markham-360/${contentSlug(e.slug)}`),
    title: e.data.title,
    dek: e.data.lead,
    dateLabel: formatDate(e.data.pubDate, locale),
    sort: e.data.pubDate.getTime(),
    image: e.data.heroImage,
    folio: String(e.data.episode),
    label: `EP. ${e.data.episode}`,
    youtubeId: undefined as string | undefined,
  })),
  ...videos.map((v) => ({
    kind: 'video' as const,
    id: v.id,
    href: href(base, locale, `/video/${contentSlug(v.slug)}`),
    title: v.data.title,
    dek: v.data.lead,
    dateLabel: formatDate(v.data.pubDate, locale),
    sort: v.data.pubDate.getTime(),
    image: v.data.youtubeId
      ? {
          src: `https://i.ytimg.com/vi/${v.data.youtubeId}/hqdefault.jpg`,
          alt: v.data.title,
        }
      : undefined,
    folio: undefined as string | undefined,
    label: t.explainer,
    youtubeId: v.data.youtubeId,
  })),
].sort((a, b) => b.sort - a.sort);
---
<BaseLayout title={copy.archiveTitle} locale={locale} path="/markham-360">
  <header class="container" style="padding-block: var(--space-6);"><Masthead locale={locale} /></header>
  <Nav locale={locale} />
  <main class="container" style="padding-block: var(--section-gap);">
    <h1>{t.archive}</h1>
    <p class="measure lede">{copy.archiveLede}</p>
    <PausedBanner locale={locale} />
    <div class="grid">
      {series.map((item) => (
        <StoryCard
          kind={item.kind}
          href={item.href}
          label={item.label}
          title={item.title}
          dek={item.dek}
          dateLabel={item.dateLabel}
          image={item.image}
          youtubeId={item.youtubeId}
          folio={item.folio}
        />
      ))}
      {series.length === 0 && <p class="label">-</p>}
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>
<style>
  .lede { margin: var(--space-3) 0 var(--space-5); color: var(--colour-muted); }
  .grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
