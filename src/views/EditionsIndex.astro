---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Nav from '../components/Nav.astro';
import IssueCard from '../components/IssueCard.astro';
import Footer from '../components/Footer.astro';
import { UI, PAGE_COPY } from '../utils/constants';
import {
  contentSlug,
  formatDate,
  href,
  includeDraftContent,
  type Locale,
} from '../utils/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = UI[locale];
const copy = PAGE_COPY[locale];
const base = import.meta.env.BASE_URL;
const allowDraft = includeDraftContent(locale);

const all = await getCollection(
  'editions',
  (e) => e.data.locale === locale && (allowDraft || !e.data.draft)
);
const editions = all.sort((a, b) => b.data.episode - a.data.episode);
---
<BaseLayout title={copy.archiveTitle} locale={locale} path="/markham-360">
  <header class="container" style="padding-block: var(--space-6);"><Masthead locale={locale} /></header>
  <Nav locale={locale} />
  <main class="container" style="padding-block: var(--section-gap);">
    <h1>{t.archive}</h1>
    <p class="measure">{copy.archiveLede}</p>
    <div class="list">
      {editions.map((e) => (
        <IssueCard
          href={href(base, locale, `/markham-360/${contentSlug(e.slug)}`)}
          episode={e.data.episode}
          date={formatDate(e.data.pubDate, locale)}
          title={e.data.title}
          lead={e.data.lead}
          image={e.data.heroImage}
        />
      ))}
      {editions.length === 0 && <p class="label">-</p>}
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>
<style> .list { margin-top: var(--space-6); } </style>
