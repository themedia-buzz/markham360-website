---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Byline from '../components/Byline.astro';
import { UI } from '../utils/constants';
import { authorJsonLd, getAuthor } from '../utils/authors';
import { eventJsonLd } from '../utils/eventLd';
import { formatEventTime } from '../utils/events';
import { contentSlug, href, localizePath, withBase, type Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'events'>;
}
const { locale, entry } = Astro.props;
const { Content } = await entry.render();
const t = UI[locale];
const galleryLabel: Record<Locale, string> = {
  en: 'Event photos',
  fr: 'Photos de l’événement',
  'zh-HK': '活動照片',
  'zh-CN': '活动照片',
};
const base = import.meta.env.BASE_URL;
const gallery = entry.data.gallery ?? [];
const path = `/community/${contentSlug(entry.slug)}`;
const author = await getAuthor(entry.data.author);
const pageUrl = Astro.site
  ? new URL(withBase(base, localizePath(path, locale)).replace(/^\//, ''), Astro.site).href
  : href(base, locale, path);

const eventLd = eventJsonLd({
  entry,
  locale,
  pageUrl,
  site: Astro.site,
  organizer: author ? authorJsonLd(author) : { '@type': 'Person', name: 'Alan Ho' },
});

const timeLabel = formatEventTime(entry.data.startDate, locale);
const endTime = entry.data.endDate ? formatEventTime(entry.data.endDate, locale) : '';
const placeParts = [
  entry.data.location.name,
  entry.data.location.streetAddress,
  [entry.data.location.addressLocality, entry.data.location.addressRegion]
    .filter(Boolean)
    .join(', '),
].filter(Boolean);
---
<BaseLayout
  title={`${entry.data.title} - ${t.community}`}
  description={entry.data.summary}
  locale={locale}
  path={path}
  jsonLd={eventLd}
>
  <header class="container" style="padding-block: var(--space-6);"><Masthead locale={locale} /></header>
  <Nav locale={locale} />
  <main class="container" style="padding-block: var(--section-gap);">
    <article class="event-detail">
      <p class="label">{entry.data.date}</p>
      <h1>{entry.data.title}</h1>
      {author && <Byline locale={locale} author={author} />}
      <p class="summary measure">{entry.data.summary}</p>

      <dl class="facts measure">
        {timeLabel && (
          <>
            <dt>{t.eventTime}</dt>
            <dd>{endTime ? `${timeLabel} - ${endTime}` : timeLabel}</dd>
          </>
        )}
        <dt>{t.eventLocation}</dt>
        <dd>{placeParts.join(' · ')}</dd>
        {entry.data.free && (
          <>
            <dt>{t.eventPrice}</dt>
            <dd>{t.eventFree}</dd>
          </>
        )}
      </dl>

      {entry.data.registrationUrl && (
        <p class="register">
          <a class="register-btn" href={entry.data.registrationUrl} rel="noopener noreferrer">
            {t.register}
          </a>
        </p>
      )}

      {gallery.length > 0 && (
        <figure class="hero">
          <img src={gallery[0].src} alt={gallery[0].alt} />
        </figure>
      )}

      <div class="body measure">
        <Content />
      </div>

      {gallery.length > 1 && (
        <section class="gallery" aria-label={galleryLabel[locale]}>
          {gallery.slice(1).map((img) => (
            <figure>
              <img src={img.src} alt={img.alt} loading="lazy" />
            </figure>
          ))}
        </section>
      )}

      <p class="back"><a href={href(base, locale, '/community')}>← {t.backCommunity}</a></p>
    </article>
  </main>
  <Footer locale={locale} />
</BaseLayout>

<style>
  .event-detail h1 { margin: var(--space-2) 0 var(--space-3); }
  .summary {
    margin: 0 0 var(--space-5);
    color: var(--colour-muted);
    font-size: 1.1rem;
  }
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-5);
    font-size: 0.95rem;
  }
  .facts dt {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--colour-muted);
  }
  .facts dd { margin: 0; }
  .register { margin: 0 0 var(--space-6); }
  .register-btn {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--colour-ink);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--colour-ink);
    text-decoration: none;
  }
  .register-btn:hover {
    border-color: var(--colour-accent);
    color: var(--colour-accent);
    text-decoration: none;
  }
  .hero { margin: 0 0 var(--space-6); }
  .hero img { border-radius: var(--radius-sm); width: 100%; }
  .body { margin-bottom: var(--space-7); }
  .gallery {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  @media (min-width: 640px) {
    .gallery { grid-template-columns: repeat(2, 1fr); }
  }
  .gallery figure { margin: 0; }
  .gallery img { border-radius: var(--radius-sm); width: 100%; }
  .back { margin-top: var(--space-4); }
</style>
