---
import BaseLayout from '../layouts/BaseLayout.astro';
import CampaignBanner from '../components/CampaignBanner.astro';
import Masthead from '../components/Masthead.astro';
import Nav from '../components/Nav.astro';
import StoryCard from '../components/StoryCard.astro';
import UpcomingEventRow from '../components/UpcomingEventRow.astro';
import PausedBanner from '../components/PausedBanner.astro';
import Footer from '../components/Footer.astro';
import { UI, PAGE_COPY } from '../utils/constants';
import { buildFeed } from '../utils/feed';
import { formatEventDay, formatEventTime, getUpcomingEvents } from '../utils/events';
import { contentSlug, href, type Locale } from '../utils/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = UI[locale];
const copy = PAGE_COPY[locale];
const base = import.meta.env.BASE_URL;

const feed = await buildFeed(base, locale);
const series = feed.filter((i) => i.kind === 'edition' || i.kind === 'video');
const communityNews = feed.filter((i) => i.kind === 'article');

/** Lead must have a cover (photo or video thumb); never a bare folio placeholder. */
const lead =
  feed.find((i) => Boolean(i.image?.src) || Boolean(i.youtubeId)) ?? feed[0];
const upcoming = await getUpcomingEvents(locale, 4);
const moreSeries = series.slice(0, 6);
const moreCommunity = communityNews.filter((i) => i.id !== lead?.id).slice(0, 6);

function eventMeta(startDate: string, locationName: string): string {
  const time = formatEventTime(startDate, locale);
  return [time, locationName].filter(Boolean).join(' · ');
}
---
<BaseLayout
  title={copy.homeTitle}
  description={copy.homeDescription}
  shareDescription={copy.homeShareDescription}
  locale={locale}
  path="/"
>
  <CampaignBanner locale={locale} />

  <header class="paper-header">
    <div class="container">
      <Masthead locale={locale} centered />
    </div>
  </header>

  <Nav locale={locale} />

  <main>

    <section class="container lead-band">
      <div class="lead-grid">
        <div class="lead-main">
          {lead && (
            <StoryCard
              size="lead"
              kind={lead.kind}
              href={lead.href}
              label={lead.label}
              title={lead.title}
              dek={lead.dek}
              dateLabel={lead.dateLabel}
              image={lead.image}
              youtubeId={lead.youtubeId}
              folio={lead.episode ? String(lead.episode) : undefined}
            />
          )}
        </div>
        <aside class="lead-rail" aria-label={t.upcomingEvents}>
          <p class="label rail-head">{t.upcomingEvents}</p>
          {upcoming.length === 0 && (
            <p class="rail-empty">{t.noUpcomingEvents}</p>
          )}
          {upcoming.map((entry) => (
            <UpcomingEventRow
              compact
              href={href(base, locale, `/community/${contentSlug(entry.slug)}`)}
              title={entry.data.title}
              dayLabel={formatEventDay(entry.data.startDate, locale)}
              meta={eventMeta(entry.data.startDate, entry.data.location.name)}
              free={entry.data.free}
              freeLabel={t.eventFree}
              registerHref={entry.data.registrationUrl}
              registerLabel={t.register}
            />
          ))}
          <a class="rail-link" href={href(base, locale, '/community')}>{t.allEvents} →</a>
        </aside>
      </div>
    </section>

    <section class="band surface-white">
      <div class="container">
        <div class="band-head">
          <h2>{t.community}</h2>
          <a class="band-link" href={href(base, locale, '/community')}>{t.allCommunity} →</a>
        </div>
        <p class="band-lede measure">{t.communityLede}</p>
        <div class="photo-row">
          {moreCommunity.map((item) => (
            <StoryCard
              kind={item.kind}
              href={item.href}
              label={item.label}
              title={item.title}
              dek={item.dek}
              dateLabel={item.dateLabel}
              image={item.image}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="container">
        <div class="band-head">
          <h2>{t.latestEditions}</h2>
          <a class="band-link" href={href(base, locale, '/markham-360')}>{t.archive} →</a>
        </div>
        <PausedBanner locale={locale} />
        <p class="band-lede measure">{t.editionsLede}</p>
        <div class="edition-strip">
          {moreSeries.map((item) => (
            <StoryCard
              kind={item.kind}
              href={item.href}
              label={item.label}
              title={item.title}
              dek={item.dek}
              dateLabel={item.dateLabel}
              image={item.image}
              youtubeId={item.youtubeId}
              folio={item.episode ? String(item.episode) : undefined}
            />
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</BaseLayout>

<style>
  .paper-header {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.7) 0%, transparent 70%),
      var(--colour-paper);
  }

  .lead-band { padding-block: var(--space-7) var(--space-5); }
  .lead-grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 960px) {
    .lead-grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(17rem, 0.85fr);
      gap: var(--space-7);
    }
  }
  .lead-main { min-width: 0; }
  .lead-rail {
    border-top: 1px solid var(--colour-rule);
    padding-top: var(--space-3);
  }
  @media (min-width: 960px) {
    .lead-rail {
      border-top: 0;
      border-left: 1px solid var(--colour-rule);
      padding-top: 0;
      padding-left: var(--space-5);
    }
  }
  .rail-head { margin: 0 0 var(--space-1); }
  .rail-empty {
    margin: var(--space-3) 0;
    color: var(--colour-muted);
    font-size: 0.9rem;
  }
  .rail-link {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .band {
    padding-block: var(--section-gap);
    border-top: 1px solid var(--colour-rule);
  }
  .surface-white { background: var(--colour-white); }
  .band-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .band-head h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
  }
  .band-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .band-lede {
    margin: var(--space-4) 0 var(--space-6);
    color: var(--colour-muted);
  }

  .edition-strip,
  .photo-row {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 640px) {
    .edition-strip,
    .photo-row { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .edition-strip { grid-template-columns: repeat(3, 1fr); }
    .photo-row { grid-template-columns: repeat(3, 1fr); }
  }
</style>
