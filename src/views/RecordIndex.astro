---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Nav from '../components/Nav.astro';
import PillarCard from '../components/PillarCard.astro';
import Footer from '../components/Footer.astro';
import { PILLARS, PAGE_COPY } from '../utils/constants';
import { getPillarContent, pillarTitle } from '../utils/pillars';
import { href, type Locale } from '../utils/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = PAGE_COPY[locale];
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={copy.recordTitle} locale={locale} path="/record">
  <header class="container" style="padding-block: var(--space-6);"><Masthead locale={locale} /></header>
  <Nav locale={locale} />
  <main class="container" style="padding-block: var(--section-gap);">
    <p class="label">{copy.recordEyebrow}</p>
    <h1>{copy.recordH1}</h1>
    <p class="measure">{copy.recordLede}</p>
    <div class="list">
      {PILLARS.map((p) => (
        <PillarCard
          letter={p.letter}
          title={pillarTitle(p.slug, locale)}
          meaning={getPillarContent(p.slug, locale).meaning}
          href={href(base, locale, `/record/${p.slug}`)}
        />
      ))}
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>
<style>
  .list {
    margin-top: var(--space-6);
    max-width: 52rem;
    border-top: 1px solid var(--colour-rule);
  }
</style>
