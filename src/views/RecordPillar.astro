---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { UI } from '../utils/constants';
import { getPillarContent, pillarTitle } from '../utils/pillars';
import { href, type Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
  slug: string;
  letter: string;
}
const { locale, slug, letter } = Astro.props;
const content = getPillarContent(slug, locale);
const title = pillarTitle(slug, locale);
const t = UI[locale];
const base = import.meta.env.BASE_URL;
const path = `/record/${slug}`;
---
<BaseLayout title={`${title} - ${t.record}`} locale={locale} path={path}>
  <header class="container" style="padding-block: var(--space-6);"><Masthead locale={locale} /></header>
  <Nav locale={locale} />
  <main class="container" style="padding-block: var(--section-gap);">
    <article class="measure pillar-article">
      <p class="label"><span class="accent">{letter}</span> · S.M.A.R.T.</p>
      <h1>{title}</h1>
      <p class="lede">{content.meaning}</p>

      {content.body.map((para) => <p>{para}</p>)}

      <section class="proof">
        <h2>{t.theRecord}</h2>
        <ul>
          {content.record.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="promise">
        <h2>{t.whatNext}</h2>
        <p>{content.promise}</p>
      </section>

      <p class="back"><a href={href(base, locale, '/record')}>← {t.backPillars}</a></p>
    </article>
  </main>
  <Footer locale={locale} />
</BaseLayout>

<style>
  .pillar-article { display: grid; gap: var(--space-5); }
  .lede {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.45;
    color: var(--colour-ink);
    margin: 0;
  }
  .pillar-article p { margin: 0; }
  .proof, .promise {
    border-top: 1px solid var(--colour-rule);
    padding-top: var(--space-6);
    margin-top: var(--space-2);
  }
  .proof h2, .promise h2 { font-size: 1.35rem; }
  .proof ul {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-3);
    color: var(--colour-ink);
  }
  .back {
    border-top: 1px solid var(--colour-rule);
    padding-top: var(--space-5);
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
