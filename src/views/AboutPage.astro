---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { PAGE_COPY, UI } from '../utils/constants';
import { href, type Locale } from '../utils/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = PAGE_COPY[locale];
const t = UI[locale];
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={copy.aboutTitle} locale={locale} path="/about">
  <header class="container" style="padding-block: var(--space-6);"><Masthead locale={locale} /></header>
  <Nav locale={locale} />
  <main class="container measure" style="padding-block: var(--section-gap);">
    <h1>{copy.aboutH1}</h1>
    <p>{copy.aboutIntro}</p>
    <h2>{copy.aboutRolesH2}</h2>
    <ul>{copy.aboutRoles.map((r) => <li>{r}</li>)}</ul>
    <p class="label">{copy.aboutNote}</p>
    <p class="contributors">
      <a href={href(base, locale, '/authors')}>{t.authors} →</a>
    </p>
  </main>
  <Footer locale={locale} />
</BaseLayout>

<style>
  .contributors { margin-top: var(--space-7); }
  .contributors a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
